# Passwords, Tokens, API keys
.env

# CakePHP 3

/vendor/
/config/app.php

/tmp/cache/models/*
!/tmp/cache/models/empty
/tmp/cache/persistent/*
!/tmp/cache/persistent/empty
/tmp/cache/views/*
!/tmp/cache/views/empty
/tmp/sessions/*
!/tmp/sessions/empty
/tmp/tests/*
!/tmp/tests/empty

/logs/*
!/logs/empty

# CakePHP 2

/app/tmp/*
/app/Config/core.php
/app/Config/database.php
/vendors/*

# macOS
.DS_Store
*.pem

# dependencies
node_modules/

# npm release build
public/
public/*

# php-cs-fixer's incremental cache (make lint / make lint-fix)
.php-cs-fixer.cache

# Development tools with their own composer.json, kept out of the plugin's
# runtime vendor/ on purpose — see the "Code style" section of the Makefile.
dev/tools/vendor/

# VS Code: the two files below are shared deliberately (#43), so they are
# un-ignored here. A contributor's *global* ignore very often excludes
# .vscode/, and a repository .gitignore outranks it — without these lines the
# files exist on disk, are documented in the README, and are silently never
# committed.
!.vscode/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# test results
tests/.phpunit.result.cache
tests/results/
.phpunit.cache/
cypress/screenshots/
cypress/ui-screenshots/
cypress/videos/
cypress/downloads/

# output of dev/inspect.mjs
dev/out/

.claude/
cypress/tests/live/.last-run.json
dev/tls/
