msgid "plugins.generic.codecheck.codecheckerNeededEmail.name"
msgstr "CODECHECK: codechecker needed"

msgid "plugins.generic.codecheck.codecheckerNeededEmail.description"
msgstr "Sent to an editor when they are assigned to a submission that takes part in a CODECHECK and has no codechecker yet."

msgid "plugins.generic.codecheck.codecheckerNeededEmail.subject"
msgstr "A codechecker is needed"

msgid "plugins.generic.codecheck.codecheckerNeededEmail.body"
msgstr ""
"<p>Dear {$recipientName},</p>"
"<p>The submission <a href=\"{$submissionUrl}\">{$submissionTitle}</a>, which you are assigned to, takes part in a CODECHECK and has no codechecker yet.</p>"
"<p>A codechecker is invited as a reviewer: in a review round, use \"Add Reviewer\" and choose the \"Invitation to codecheck\" message, then add them on the submission's CODECHECK tab. More about the CODECHECK process is at <a href=\"https://codecheck.org.uk/\">codecheck.org.uk</a>.</p>"
"{$contextSignature}"
